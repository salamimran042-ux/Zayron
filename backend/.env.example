# Copy to .env for local development. Replace placeholders only on your machine.
# Never commit real credentials or production secrets.
ZAYRON_ENVIRONMENT=development
ZAYRON_LOG_LEVEL=INFO

# Runtime API URL must authenticate as the NOINHERIT zayron_runtime role.
# That role can SET LOCAL ROLE to zayron_api or zayron_worker; it must not
# connect as postgres, service_role, or a Supabase secret API key.
ZAYRON_DATABASE_URL=

# Privileged URL used only by the one-off migration command. Keep it out of
# the running API service environment and never expose it to Android.
ZAYRON_MIGRATION_DATABASE_URL=

ZAYRON_SUPABASE_URL=

# Current Supabase API key format. The publishable key is used by the
# server-side Auth adapter; it is not a secret. Keep secret keys server-only.
ZAYRON_SUPABASE_PUBLISHABLE_KEY=
ZAYRON_SUPABASE_SECRET_KEY=

# Legacy compatibility only. Prefer the current names above.
# Remove these after migrating an existing project.
ZAYRON_SUPABASE_ANON_KEY=
ZAYRON_SUPABASE_SERVICE_ROLE_KEY=

# Token verification uses the project's public JWKS endpoint derived from SUPABASE_URL.
# No JWT secret or Supabase secret key is required by the verifier.

# Separate high-entropy secret for internal worker endpoints; never expose to Android.
ZAYRON_WORKER_TOKEN=
